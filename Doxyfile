# Rozeta Doxygen configuration
# Public headers are the source of truth for generated API docs.
PROJECT_NAME           = "Rozeta"
PROJECT_BRIEF          = "Linux-first modular C/C++ robotics library"
PROJECT_NUMBER         = 0.1.0
OUTPUT_DIRECTORY       = docs/generated
INPUT                  = include src examples
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.h *.cpp *.c
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_XML           = YES
XML_OUTPUT             = xml
GENERATE_LATEX         = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
INLINE_SOURCES         = YES
SOURCE_BROWSER         = YES
REFERENCES_LINK_SOURCE = YES
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
